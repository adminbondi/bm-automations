# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars.
# DEV_MODE stays true until an owner is ready to message real clients.
# CONTACT_WRITE_MODE defaults to shared_sync in wrangler.jsonc.
# self writes listmonk subscribers only in dev mode, and only for SEND_ALLOWLIST.
# Empty values keep the worker from calling live APIs.

MINDBODY_API_KEY=
MINDBODY_STAFF_USERNAME=
MINDBODY_STAFF_PASSWORD=
MINDBODY_WEBHOOK_SIGNATURE_KEY=
LISTMONK_API_USER=
LISTMONK_API_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
ADMIN_EMAILS=
SETTINGS_ENCRYPTION_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMS_ALLOWLIST=
# Optional. Bearer token for GET /admin/send-log only (Authorization: Bearer <token>).
# Empty/unset keeps that path closed. Do not use for other /admin routes.
AGENT_READ_TOKEN=
# Leave HANDOFF_SECRET empty to keep Google login on this worker.
# Set the same value as bm-home only when home sign-in should take over.
HANDOFF_SECRET=
HOME_ORIGIN=
