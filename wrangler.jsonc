{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bm-automations",
  "account_id": "a1e049769abbd70837e055ac5a0f9c7b",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  // 22:00 UTC is 09:00 Australia/Sydney during daylight saving (AEDT, UTC+11).
  // 23:00 UTC is 09:00 during standard time (AEST, UTC+10).
  // The handler runs the job only when the Sydney hour is SYDNEY_SEND_HOUR.
  "triggers": {
    "crons": ["0 22 * * *", "0 23 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bm-automations",
      // Replace this placeholder after `wrangler d1 create bm-automations`.
      // Local dev and tests do not need a remote database.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "DEV_MODE": "true",
    "DRY_RUN": "false",
    "SEND_ALLOWLIST": "bondi@balancemoves.com.au",
    "SMS_ALLOWLIST": "",
    "MINDBODY_SITE_ID": "9853",
    "LISTMONK_BASE_URL": "https://campaigns.balancemoves.com.au",
    "LISTMONK_LIST_ID": "",
    "LISTMONK_SUPPRESSED_LIST_ID": "",
    "SYDNEY_SEND_HOUR": "9",
    "ADMIN_EMAILS": "",
    "DEFAULT_FROM_EMAIL": "",
    "SMS_QUIET_START": "20:00",
    "SMS_QUIET_END": "09:00",
    "STUDIO_NAME": "Balance Moves",
    "CONTACT_WRITE_MODE": "shared_sync",
    "TWILIO_FROM_NUMBER": "",
    "TWILIO_SENDER_NAME": ""
  },
  "secrets": {
    "required": [
      "MINDBODY_API_KEY",
      "MINDBODY_STAFF_USERNAME",
      "MINDBODY_STAFF_PASSWORD",
      "MINDBODY_WEBHOOK_SIGNATURE_KEY",
      "LISTMONK_API_USER",
      "LISTMONK_API_TOKEN",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "SESSION_SECRET",
      "SETTINGS_ENCRYPTION_KEY",
      "TWILIO_ACCOUNT_SID",
      "TWILIO_AUTH_TOKEN"
    ]
  },
  // Wrangler does not inherit vars, secrets, or D1 into an environment.
  // `./scripts/deploy.sh dev` deploys this as the Worker bm-automations-dev.
  "env": {
    "dev": {
      "name": "bm-automations-dev",
      // Repeated so dev does not depend on top-level inheritance.
      // 22:00 UTC is 09:00 Sydney during AEDT. 23:00 UTC is 09:00 during AEST.
      "triggers": {
        "crons": ["0 22 * * *", "0 23 * * *"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bm-automations-dev",
          "database_id": "6b95adf8-010b-4608-b2d2-f3172bd1fb8b",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "DEV_MODE": "true",
        "DRY_RUN": "false",
        "SEND_ALLOWLIST": "bondi@balancemoves.com.au",
        "SMS_ALLOWLIST": "",
        "MINDBODY_SITE_ID": "9853",
        "LISTMONK_BASE_URL": "https://campaigns.balancemoves.com.au",
        "LISTMONK_LIST_ID": "",
        "LISTMONK_SUPPRESSED_LIST_ID": "",
        "SYDNEY_SEND_HOUR": "9",
        "ADMIN_EMAILS": "admin@balancemoves.com.au",
        "DEFAULT_FROM_EMAIL": "",
        "SMS_QUIET_START": "20:00",
        "SMS_QUIET_END": "09:00",
        "STUDIO_NAME": "Balance Moves",
        "CONTACT_WRITE_MODE": "shared_sync",
        "TWILIO_FROM_NUMBER": "",
        "TWILIO_SENDER_NAME": ""
      },
      "secrets": {
        "required": [
          "MINDBODY_API_KEY",
          "MINDBODY_STAFF_USERNAME",
          "MINDBODY_STAFF_PASSWORD",
          "MINDBODY_WEBHOOK_SIGNATURE_KEY",
          "LISTMONK_API_USER",
          "LISTMONK_API_TOKEN",
          "GOOGLE_CLIENT_ID",
          "GOOGLE_CLIENT_SECRET",
          "SESSION_SECRET",
          "SETTINGS_ENCRYPTION_KEY",
          "TWILIO_ACCOUNT_SID",
          "TWILIO_AUTH_TOKEN"
        ]
      }
    }
  }
}
